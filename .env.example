# Copiare in .env.local (mai versionato). I valori Firebase sono gli stessi del progetto
# Cicli-game / html-escape-room: l'Officina del corso usa lo stesso progetto Firebase, con
# collezioni proprie (webOfficina*). Il manuale funziona anche senza niente di tutto questo:
# serve solo all'Officina (/officina).

# --- Firebase Admin SDK (solo server) ---
FIREBASE_PROJECT_ID=html-css-attivita
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@html-css-attivita.iam.gserviceaccount.com
# Chiave privata su una riga sola, con "\n" letterali al posto degli a-capo.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Su Vercel è più sicuro caricarla in base64 (una stringa sola, che la riga di comando di
# Windows non può troncare al primo \n): se c'è, vince su FIREBASE_PRIVATE_KEY.
#   node -e "process.loadEnvFile('.env.local');console.log(Buffer.from(process.env.FIREBASE_PRIVATE_KEY).toString('base64'))"
# FIREBASE_PRIVATE_KEY_BASE64=

# --- Docente ---
# Email autorizzate all'area docente, separate da virgola.
TEACHER_EMAILS=nome.cognome@scuola.it

# --- Firebase SDK client (login Google e dashboard in tempo reale) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=html-css-attivita.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=html-css-attivita
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Allievi ---
# Dominio (o domini, separati da virgola) degli account Google ammessi. Vuoto = tutti.
OFFICINA_DOMINIO=

# --- Tutor e giudice (Anthropic) ---
# Senza chiave rispondono un tutor e un giudice finti (va bene in sviluppo, non in classe).
ANTHROPIC_API_KEY=
# Modelli (default: tutor claude-sonnet-5-5, giudice claude-haiku-5-5).
# TUTOR_MODEL=
# GIUDICE_MODEL=
# Impostato dai test: forza tutor e giudice finti anche con la chiave.
# OFFICINA_IA_FINTA=1

# --- Opzionali ---
# Richieste al minuto per allievo (default 30).
OFFICINA_RATE_LIMIT_PER_MINUTE=30
# Impostate dai test con gli emulatori, non in sviluppo normale:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
